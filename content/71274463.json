войте фундаментальные навыки работы с опорно-двигательным аппаратом и станьте востребованным специалистом!<br/>🔥 Подробности и запись на курс — на<a href=\"/\"> Kinezio Fitness</a> 🚀","style":"padding-top:60px;padding-bottom:60px;background-color:#f5f5f5; "},{"kind":"scene","id":"1120793601"},{"kind":"scene","id":"721186470"}],"popups":[],"anchors":[],"missingMediaCount":0,"unsupported":[]}